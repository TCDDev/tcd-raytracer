{
  "version": 6,

  "configurePresets": [
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-perf",
      "displayName": "Clang RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-perf",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "gcc-perf",
      "displayName": "GCC RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-perf",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":"RelWithDebInfo",
        "CMAKE_CXX_COMPILER":"g++"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "clang-build",
      "configurePreset": "clang-debug"
    },
    {
      "name": "gcc-build",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "clang-perf-build",
      "configurePreset": "clang-perf"
    },
    {
      "name": "gcc-perf-build",
      "configurePreset": "gcc-perf"
    }
  ]
}